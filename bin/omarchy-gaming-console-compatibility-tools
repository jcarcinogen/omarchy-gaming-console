#!/usr/bin/env python3
"""Install or remove OGC-owned optional Steam compatibility tools safely."""
from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import platform
import shutil
import stat
import sys
import tarfile
import tempfile
import time
import urllib.request

SCHEMA = 1
DOWNLOAD_CHUNK_BYTES = 1024 * 1024
DOWNLOAD_TOTAL_SECONDS = 30 * 60
RELEASES = [
    {
        "name": "Proton-CachyOS SLR",
        "release": "cachyos-11.0-20260703-slr",
        "archive": "proton-cachyos-11.0-20260703-slr-x86_64.tar.xz",
        "url": "https://github.com/CachyOS/proton-cachyos/releases/download/cachyos-11.0-20260703-slr/proton-cachyos-11.0-20260703-slr-x86_64.tar.xz",
        "sha512": "713fe008d67e3491aef3b5b1d9ae2c112d7c2b58b3f23fc2387d1122fc131ff7e7f0ea27c67bf27973d906bdce6235c34098530ec4c786059438b153c6e16187",
        "size": 335059640,
        "directory": "proton-cachyos-11.0-20260703-slr-x86_64",
        "tool_id": "proton-cachyos-11.0-20260703-slr-x86_64",
    },
    {
        "name": "GE-Proton",
        "release": "GE-Proton11-7",
        "archive": "GE-Proton11-7-x86_64.tar.gz",
        "url": "https://github.com/GloriousEggroll/proton-ge-custom/releases/download/GE-Proton11-7/GE-Proton11-7-x86_64.tar.gz",
        "sha512": "7db87e9787e20c35cbdac26018431d5794626b626e4067b050684e45a88cc2ca229d7d263519eafb2e168cde5bef57611065d159d3685aaec152ccb9abe3073f",
        "size": 563784602,
        "directory": "GE-Proton11-7-x86_64",
        "tool_id": "GE-Proton11-7-x86_64",
    },
]


def fail(message: str) -> "NoReturn":
    print(f"REFUSE: {message}", file=sys.stderr)
    raise SystemExit(78)


def sha512(path: Path) -> str:
    digest = hashlib.sha512()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def owned_directory(path: Path, mode: int | None = None) -> bool:
    try:
        info = path.lstat()
    except OSError:
        return False
    return (
        stat.S_ISDIR(info.st_mode)
        and info.st_uid == os.geteuid()
        and info.st_gid == os.getegid()
        and (mode is None or stat.S_IMODE(info.st_mode) == mode)
    )


def ensure_private_directory(path: Path) -> None:
    if path.exists() or path.is_symlink():
        if not owned_directory(path):
            fail(f"unsafe directory: {path}")
        return
    path.mkdir(parents=True, mode=0o700)
    path.chmod(0o700)


def steam_root() -> Path:
    data_home = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
    root = data_home / "Steam"
    try:
        resolved = root.resolve(strict=True)
    except OSError:
        fail("native Steam data directory is missing; launch Steam once first")
    if not owned_directory(resolved):
        fail(f"Steam data directory is unsafe: {resolved}")
    return resolved


def state_paths() -> tuple[Path, Path]:
    base = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "omarchy-gaming-console"
    return base, base / "compatibility-tools.json"


def cache_directory() -> Path:
    base = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy-gaming-console/downloads"
    ensure_private_directory(base)
    return base


def release_records() -> list[dict[str, object]]:
    raw = os.environ.get("OGC_COMPAT_RELEASES_JSON") if os.environ.get("OGC_COMPAT_TESTING") == "1" else None
    records = json.loads(raw) if raw else RELEASES
    required = {"name", "release", "archive", "url", "sha512", "size", "directory", "tool_id"}
    if not isinstance(records, list) or len(records) != 2:
        fail("release metadata must contain exactly two tools")
    for record in records:
        if not isinstance(record, dict) or set(record) != required:
            fail("release metadata is malformed")
        for key, value in record.items():
            if key == "size":
                continue
            if not isinstance(value, str) or not value:
                fail("release metadata contains an invalid value")
        if not isinstance(record["size"], int) or isinstance(record["size"], bool) or record["size"] <= 0:
            fail("release metadata contains an invalid size")
        if "/" in record["directory"] or "/" in record["archive"]:
            fail("release metadata contains an unsafe path")
        if len(record["sha512"]) != 128 or any(c not in "0123456789abcdef" for c in record["sha512"]):
            fail("release metadata contains an invalid checksum")
    return records


def config_files(root: Path) -> list[Path]:
    paths = [root / "config/config.vdf"]
    userdata = root / "userdata"
    if userdata.is_dir() and not userdata.is_symlink():
        for user in userdata.iterdir():
            if user.is_dir() and not user.is_symlink():
                paths.extend((user / "config/localconfig.vdf", user / "config/sharedconfig.vdf"))
    return [path for path in paths if path.is_file() and not path.is_symlink()]


def config_hashes(root: Path) -> dict[str, str]:
    return {str(path): sha256_file(path) for path in config_files(root)}


def selected_in_config(root: Path, tool_id: str) -> bool:
    needle = ('"' + tool_id + '"').encode()
    for path in config_files(root):
        try:
            if needle in path.read_bytes():
                return True
        except OSError:
            fail(f"could not inspect Steam mapping file: {path}")
    return False


def safe_archive_members(archive: Path, expected_top: str) -> list[tarfile.TarInfo]:
    with tarfile.open(archive, "r:*") as handle:
        members = handle.getmembers()
    if not members:
        fail(f"empty archive: {archive.name}")
    for member in members:
        raw = PurePosixPath(member.name)
        if raw.is_absolute() or not raw.parts or raw.parts[0] != expected_top or ".." in raw.parts:
            fail(f"unsafe archive member: {member.name}")
        if member.ischr() or member.isblk() or member.isfifo():
            fail(f"unsupported archive member type: {member.name}")
        if member.issym():
            target = PurePosixPath(member.linkname)
            combined = PurePosixPath(os.path.normpath(str(raw.parent / target)))
            if target.is_absolute() or not combined.parts or combined.parts[0] != expected_top or ".." in combined.parts:
                fail(f"unsafe archive symlink: {member.name}")
        if member.islnk():
            target = PurePosixPath(os.path.normpath(member.linkname))
            if target.is_absolute() or not target.parts or target.parts[0] != expected_top or ".." in target.parts:
                fail(f"unsafe archive hardlink: {member.name}")
    return members


def download(record: dict[str, object], cache: Path) -> Path:
    destination = cache / str(record["archive"])
    expected = str(record["sha512"])
    expected_size = int(record["size"])
    if destination.is_file() and not destination.is_symlink() and sha512(destination) == expected:
        print(f"Verified cached archive: {destination.name}")
        return destination
    partial = destination.with_name(destination.name + ".part")
    partial.unlink(missing_ok=True)
    print(f"Downloading {record['name']} {record['release']}...")
    deadline = time.monotonic() + DOWNLOAD_TOTAL_SECONDS
    try:
        with urllib.request.urlopen(str(record["url"]), timeout=60) as response, partial.open("wb") as output:
            declared_raw = response.headers.get("Content-Length")
            if declared_raw is not None:
                try:
                    declared = int(declared_raw)
                except (TypeError, ValueError) as error:
                    raise ValueError("invalid Content-Length") from error
                if declared < 0 or declared > expected_size:
                    raise ValueError(
                        f"declared download size {declared} exceeds committed size {expected_size}"
                    )
            received = 0
            while True:
                if time.monotonic() > deadline:
                    raise TimeoutError(f"download exceeded {DOWNLOAD_TOTAL_SECONDS} seconds")
                block = response.read(min(DOWNLOAD_CHUNK_BYTES, expected_size - received + 1))
                if time.monotonic() > deadline:
                    raise TimeoutError(f"download exceeded {DOWNLOAD_TOTAL_SECONDS} seconds")
                if not block:
                    break
                received += len(block)
                if received > expected_size:
                    raise ValueError(f"download exceeded committed size {expected_size}")
                output.write(block)
            if received != expected_size:
                raise ValueError(f"download size {received} does not match committed size {expected_size}")
    except Exception as error:
        partial.unlink(missing_ok=True)
        fail(f"download failed for {record['name']}: {error}")
    if sha512(partial) != expected:
        partial.unlink(missing_ok=True)
        fail(f"official SHA-512 verification failed for {record['archive']}")
    os.replace(partial, destination)
    return destination


def tree_digest(root: Path) -> str:
    digest = hashlib.sha256()
    if not owned_directory(root):
        fail(f"tool directory is unsafe: {root}")
    entries = [root]
    entries.extend(sorted(root.rglob("*"), key=lambda item: item.relative_to(root).as_posix()))
    for path in entries:
        info = path.lstat()
        relative = "." if path == root else path.relative_to(root).as_posix()
        mode = stat.S_IMODE(info.st_mode)
        if stat.S_ISDIR(info.st_mode):
            kind, payload = "d", ""
        elif stat.S_ISREG(info.st_mode):
            kind, payload = "f", sha256_file(path)
        elif stat.S_ISLNK(info.st_mode):
            kind, payload = "l", os.readlink(path)
        else:
            fail(f"unsupported object inside compatibility tool: {path}")
        digest.update(f"{kind}\0{relative}\0{mode:o}\0{payload}\n".encode())
    return digest.hexdigest()


def load_state(path: Path) -> dict[str, object]:
    if not path.exists():
        return {"schema": SCHEMA, "tools": []}
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o600:
        fail(f"unsafe compatibility-tool state: {path}")
    data = json.loads(path.read_text())
    if data.get("schema") != SCHEMA or not isinstance(data.get("tools"), list):
        fail("unsupported compatibility-tool state")
    return data


def save_state(directory: Path, path: Path, data: dict[str, object]) -> None:
    ensure_private_directory(directory)
    fd, temporary = tempfile.mkstemp(prefix="compatibility-tools.", dir=directory)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as handle:
            json.dump(data, handle, sort_keys=True, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def install_tools(root: Path, records: list[dict[str, object]]) -> None:
    tools_dir = root / "compatibilitytools.d"
    if tools_dir.exists() or tools_dir.is_symlink():
        if not owned_directory(tools_dir):
            fail(f"unsafe compatibilitytools.d: {tools_dir}")
    else:
        tools_dir.mkdir(mode=0o700)
    state_dir, state_file = state_paths()
    state = load_state(state_file)
    previous = {item.get("tool_id"): item for item in state["tools"] if isinstance(item, dict)}
    output: list[dict[str, object]] = []
    before = config_hashes(root)
    cache = cache_directory()
    for record in records:
        target = tools_dir / str(record["directory"])
        prior = previous.get(record["tool_id"], {})
        if target.exists() or target.is_symlink():
            if not owned_directory(target):
                fail(f"existing compatibility tool path is unsafe: {target}")
            if prior.get("owned") is True and prior.get("tree_sha256") == tree_digest(target):
                item = dict(prior)
                item["status"] = "installed-owned"
                print(f"Already installed and owned: {record['name']} {record['release']}")
            else:
                item = dict(record)
                item.update({"owned": False, "status": "preexisting-preserved", "path": str(target)})
                print(f"Preserved pre-existing tool: {target.name}")
            output.append(item)
            continue
        archive = download(record, cache)
        safe_archive_members(archive, str(record["directory"]))
        with tempfile.TemporaryDirectory(prefix=".ogc-compat-", dir=tools_dir) as staging_name:
            staging = Path(staging_name)
            with tarfile.open(archive, "r:*") as handle:
                handle.extractall(staging)
            extracted = staging / str(record["directory"])
            if not owned_directory(extracted):
                fail(f"archive did not contain the expected directory: {record['directory']}")
            manifest = extracted / "compatibilitytool.vdf"
            if not manifest.is_file() or ('"' + str(record["tool_id"]) + '"').encode() not in manifest.read_bytes():
                fail(f"archive manifest does not declare {record['tool_id']}")
            os.replace(extracted, target)
        item = dict(record)
        item.update({"owned": True, "status": "installed-owned", "path": str(target), "tree_sha256": tree_digest(target)})
        output.append(item)
        state["tools"] = output
        save_state(state_dir, state_file, state)
        print(f"Installed optional tool: {record['name']} {record['release']}")
    state["tools"] = output
    save_state(state_dir, state_file, state)
    if config_hashes(root) != before:
        fail("Steam compatibility mappings changed unexpectedly")
    print("Steam compatibility mappings were not changed. Restart Steam to discover new tools.")


def uninstall_tools(root: Path) -> None:
    state_dir, state_file = state_paths()
    state = load_state(state_file)
    before = config_hashes(root)
    tools_dir = root / "compatibilitytools.d"
    remaining: list[dict[str, object]] = []
    for raw in state["tools"]:
        if not isinstance(raw, dict):
            fail("malformed compatibility-tool state record")
        item = dict(raw)
        if item.get("owned") is not True:
            item["status"] = "preexisting-preserved"
            remaining.append(item)
            continue
        target = Path(str(item.get("path", "")))
        expected = tools_dir / str(item.get("directory", ""))
        if target != expected or target.parent != tools_dir:
            fail("state contains an unsafe compatibility-tool path")
        if not target.exists() and not target.is_symlink():
            print(f"Owned tool already absent: {item.get('name')}")
            continue
        if selected_in_config(root, str(item.get("tool_id", ""))):
            item["status"] = "preserved-selected"
            remaining.append(item)
            print(f"Preserved selected compatibility tool: {item.get('name')}")
            continue
        if not owned_directory(target) or tree_digest(target) != item.get("tree_sha256"):
            item["status"] = "preserved-modified"
            remaining.append(item)
            print(f"Preserved modified compatibility tool: {item.get('name')}")
            continue
        shutil.rmtree(target)
        print(f"Removed unchanged project-owned tool: {item.get('name')}")
    if remaining:
        state["tools"] = remaining
        save_state(state_dir, state_file, state)
    else:
        state_file.unlink(missing_ok=True)
        try:
            state_dir.rmdir()
        except OSError:
            pass
    if config_hashes(root) != before:
        fail("Steam compatibility mappings changed unexpectedly")
    print("Steam compatibility mappings were not changed.")


def status(root: Path) -> None:
    _, state_file = state_paths()
    state = load_state(state_file)
    result = {"schema": SCHEMA, "tools": []}
    for record in release_records():
        target = root / "compatibilitytools.d" / str(record["directory"])
        match = next((item for item in state["tools"] if isinstance(item, dict) and item.get("tool_id") == record["tool_id"]), None)
        result["tools"].append({
            "name": record["name"],
            "release": record["release"],
            "tool_id": record["tool_id"],
            "present": target.is_dir() and not target.is_symlink(),
            "owned": bool(match and match.get("owned") is True),
            "status": match.get("status") if match else "unrecorded",
        })
    print(json.dumps(result, sort_keys=True))


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in {"install", "uninstall", "status"}:
        print(f"Usage: {sys.argv[0]} install|uninstall|status", file=sys.stderr)
        return 64
    if os.geteuid() == 0 and os.environ.get("OGC_COMPAT_TESTING") != "1":
        fail("run compatibility-tool management as the desktop user, never root")
    if platform.machine() != "x86_64" and os.environ.get("OGC_COMPAT_TESTING") != "1":
        fail(f"these pinned compatibility tools require x86_64 (found {platform.machine()})")
    root = steam_root()
    if sys.argv[1] == "install":
        install_tools(root, release_records())
    elif sys.argv[1] == "uninstall":
        uninstall_tools(root)
    else:
        status(root)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
