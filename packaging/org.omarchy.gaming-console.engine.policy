<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Omarchy Gaming Console</vendor>
  <vendor_url>https://github.com/jcarcinogen/omarchy-gaming-console</vendor_url>
  <action id="org.omarchy.gaming-console.engine.manage">
    <description>Install, repair, or remove the reviewed Omarchy Gaming Console engine</description>
    <message>Authentication is required to manage the Omarchy Gaming Console system engine</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/omarchy-gaming-console/engine-manager</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>
