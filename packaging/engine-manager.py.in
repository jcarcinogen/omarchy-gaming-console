#!/usr/bin/env python3
"""Package-owned privileged lifecycle manager for Omarchy Gaming Console.

The package build replaces @REVIEWED_COMMIT@ with one exact marketplace-reviewed
commit. This root-owned program accepts only a lifecycle verb, fetches only that
commit, checks it out detached, and executes the fetched bootstrap. It never
reads the user-writable plugin checkout and never accepts a repository or
commit from its caller.
"""

from __future__ import annotations

import os
import re
import signal
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ORIGIN = "https://github.com/jcarcinogen/omarchy-gaming-console.git"
REVIEWED_COMMIT = "@REVIEWED_COMMIT@"
SELF = Path("/usr/lib/omarchy-gaming-console/engine-manager")
FETCH_TOTAL_SECONDS = 180
TERMINATE_GRACE_SECONDS = 5


def refuse(message: str) -> "None":
    print(f"REFUSE: {message}", file=sys.stderr)
    raise SystemExit(78)


def validate_installation() -> None:
    if os.geteuid() != 0:
        refuse("engine manager must run as root")
    if not re.fullmatch(r"[0-9a-f]{40}", REVIEWED_COMMIT) or len(REVIEWED_COMMIT) != 40:
        refuse("package has no exact reviewed commit")
    try:
        info = SELF.lstat()
    except OSError as exc:
        refuse(f"package-owned helper is unavailable: {exc}")
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        refuse("package-owned helper is not a regular file")
    if info.st_uid != 0 or stat.S_IMODE(info.st_mode) & 0o022:
        refuse("package-owned helper is not root-owned and immutable to users")
    if Path(sys.argv[0]).resolve() != SELF:
        refuse("engine manager must run from its package-owned path")


def terminate_process_group(process: subprocess.Popen[str]) -> None:
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    try:
        process.communicate(timeout=TERMINATE_GRACE_SECONDS)
        return
    except subprocess.TimeoutExpired:
        pass
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    process.communicate()


def git(*args: str, cwd: Path | None = None, timeout_seconds: float) -> str:
    env = {
        "HOME": "/root",
        "LANG": "C.UTF-8",
        "PATH": "/usr/bin:/bin",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_TERMINAL_PROMPT": "0",
    }
    process = subprocess.Popen(
        ["/usr/bin/git", "-c", "core.hooksPath=/dev/null", "-c", "protocol.file.allow=never", *args],
        cwd=cwd,
        env=env,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=True,
    )
    try:
        stdout, stderr = process.communicate(timeout=timeout_seconds)
    except subprocess.TimeoutExpired:
        terminate_process_group(process)
        refuse("reviewed source fetch exceeded its 180-second total deadline")
    if process.returncode != 0:
        raise subprocess.CalledProcessError(
            process.returncode,
            process.args,
            output=stdout,
            stderr=stderr,
        )
    return stdout.strip()


def fetch_reviewed_snapshot() -> Path:
    stage = Path(tempfile.mkdtemp(prefix="omarchy-gaming-console-source.", dir="/run"))
    deadline = time.monotonic() + FETCH_TOTAL_SECONDS
    try:
        os.chmod(stage, 0o700)
        os.chown(stage, 0, 0)

        def run_git(*args: str, cwd: Path | None = None) -> str:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                refuse("reviewed source fetch exceeded its 180-second total deadline")
            return git(*args, cwd=cwd, timeout_seconds=remaining)

        run_git("init", "--quiet", str(stage))
        run_git("remote", "add", "origin", ORIGIN, cwd=stage)
        run_git("fetch", "--quiet", "--depth", "1", "origin", REVIEWED_COMMIT, cwd=stage)
        run_git("checkout", "--quiet", "--detach", "FETCH_HEAD", cwd=stage)
        head = run_git("rev-parse", "HEAD", cwd=stage)
        if head != REVIEWED_COMMIT:
            refuse("fetched snapshot does not match the package-pinned commit")
        return stage
    except BaseException:
        shutil.rmtree(stage, ignore_errors=True)
        raise


def main() -> None:
    validate_installation()
    if len(sys.argv) != 2 or sys.argv[1] not in {"install", "repair", "uninstall"}:
        raise SystemExit("Usage: engine-manager install|repair|uninstall")
    mode = sys.argv[1]
    source = fetch_reviewed_snapshot()
    bootstrap = source / "system" / "privileged-bootstrap.py"
    if bootstrap.is_symlink() or not bootstrap.is_file():
        refuse("reviewed snapshot has no regular bootstrap")
    os.execv(
        "/usr/bin/python3",
        ["/usr/bin/python3", "-I", str(bootstrap), mode, str(source / "system")],
    )


if __name__ == "__main__":
    main()
