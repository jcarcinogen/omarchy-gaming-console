#!/usr/bin/env bash
# Visible engine-uninstall entry point. Plugin removal remains a separate action.
set -euo pipefail
export PATH=/usr/local/bin:/usr/bin:/bin

readonly ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly ENTRY=$ROOT/system/enter-privileged
[[ $# == 0 ]] || { printf 'Usage: %s\n' "$0" >&2; exit 64; }
[[ -x $ENTRY ]] || { printf 'Missing privileged entry: %s\n' "$ENTRY" >&2; exit 66; }

printf 'Omarchy Gaming Console — uninstall system engine\n'
printf 'This removes only recorded engine-owned objects. It does not run `omarchy plugin remove`.\n\n'

printf 'Authorization runs the reviewed root snapshot. It does not execute this folder as root.\n\n'
"$ENTRY" uninstall

printf '\nEngine removed. If desired, remove the Quattro front end separately with `omarchy plugin remove`.\n'
