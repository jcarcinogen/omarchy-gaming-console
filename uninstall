#!/usr/bin/env bash
# Visible engine-uninstall entry point. Plugin removal remains a separate action.
set -euo pipefail
export PATH=/usr/local/bin:/usr/bin:/bin

readonly ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly UNINSTALLER=$ROOT/system/uninstall.sh
readonly COMPAT_MANAGER=$ROOT/bin/omarchy-gaming-console-compatibility-tools
[[ $# == 0 ]] || { printf 'Usage: %s\n' "$0" >&2; exit 64; }
[[ -x $UNINSTALLER ]] || { printf 'Missing executable uninstaller: %s\n' "$UNINSTALLER" >&2; exit 66; }
[[ -x $COMPAT_MANAGER ]] || { printf 'Missing compatibility-tool manager: %s\n' "$COMPAT_MANAGER" >&2; exit 66; }

printf 'Omarchy Gaming Console — uninstall system engine\n'
printf 'This removes only recorded engine-owned objects. It does not run `omarchy plugin remove`.\n\n'

# Remove only unchanged user-owned tools recorded by this project. Selected,
# modified and pre-existing tools are preserved, and Steam mappings are read-only.
if (( EUID != 0 )); then
  "$COMPAT_MANAGER" uninstall
fi

if (( EUID == 0 )); then
  "$UNINSTALLER"
else
  pkexec "$UNINSTALLER"
fi

printf '\nEngine removed. If desired, remove the Quattro front end separately with `omarchy plugin remove`.\n'
