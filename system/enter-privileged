#!/usr/bin/env bash
# Visible privileged handoff. Root runs stock /usr/bin/python3 with the
# bootstrap already read through one no-follow descriptor. Root does not open
# a checkout engine script by path.
set -euo pipefail
export PATH=/usr/local/bin:/usr/bin:/bin

readonly ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
readonly BOOTSTRAP=$ROOT/system/privileged-bootstrap.py
mode=${1:-}
[[ $# -eq 1 && ( $mode == install || $mode == repair || $mode == uninstall ) ]] || {
  printf 'Usage: %s install|repair|uninstall\n' "$0" >&2
  exit 64
}
[[ -f $BOOTSTRAP && ! -L $BOOTSTRAP ]] || {
  printf 'Missing regular bootstrap: %s\n' "$BOOTSTRAP" >&2
  exit 66
}

bootstrap_code=$(/usr/bin/python3 -I -c '
import os, stat, sys
fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NOFOLLOW)
info = os.fstat(fd)
if not stat.S_ISREG(info.st_mode):
    raise SystemExit(66)
data = os.read(fd, info.st_size + 1)
again = os.fstat(fd)
os.close(fd)
if len(data) != info.st_size or again.st_ino != info.st_ino or again.st_size != info.st_size:
    raise SystemExit("bootstrap changed while reading")
sys.stdout.buffer.write(data)
' "$BOOTSTRAP")
[[ -n $bootstrap_code ]] || { printf 'Bootstrap read was empty.\n' >&2; exit 66; }

if (( EUID == 0 )); then
  /usr/bin/python3 -I -c "$bootstrap_code" "$mode" "$ROOT/system"
else
  pkexec /usr/bin/python3 -I -c "$bootstrap_code" "$mode" "$ROOT/system"
fi
