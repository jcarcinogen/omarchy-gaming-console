#!/usr/bin/env bash
# Calls only the separately installed, package-owned lifecycle manager.
# No code, URL, digest, repository, or commit from this plugin is run as root.
set -euo pipefail
export PATH=/usr/bin:/bin

readonly HELPER=/usr/lib/omarchy-gaming-console/engine-manager
mode=${1:-}
[[ $# -eq 1 && ( $mode == install || $mode == repair || $mode == uninstall ) ]] || {
  printf 'Usage: %s install|repair|uninstall\n' "$0" >&2
  exit 64
}
[[ -x $HELPER && ! -L $HELPER ]] || {
  printf 'The signed Omarchy Gaming Console engine package is not installed.\n' >&2
  printf 'Install it using the package instructions in README.md, then try again.\n' >&2
  exit 69
}

if (( EUID == 0 )); then
  "$HELPER" "$mode"
else
  pkexec "$HELPER" "$mode"
fi
