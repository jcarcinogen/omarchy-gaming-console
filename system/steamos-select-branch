#!/usr/bin/env bash
# OGC's fixed OS channel, not a repository/branch switcher.
# stdout is machine-readable Steam UI data, never a diagnostic.
if [[ $# == 1 && ( $1 == -c || $1 == -l ) ]]; then
  printf 'Omarchy\n'
  exit 0
fi
if [[ $# == 1 && $1 == stable ]]; then
  exit 0
fi
printf 'Usage: steamos-select-branch <-c|-l|stable>; OS updates use Omarchy.\n' >&2
exit 1
